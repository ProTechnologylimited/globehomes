# Public site URL (used for Stripe redirects). Use http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` (dev) or the webhook endpoint you create in the dashboard (prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase: Project settings > API. Server-only, never expose the service role key.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Admin panel at /admin. Use a long random password and a separate long random secret
# (for example: openssl rand -hex 32).
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
